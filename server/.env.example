# LumenStay Server Environment Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Supabase PostgreSQL Configuration
# Set these from your Supabase Project Settings -> API & Keys:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_pub_...
SUPABASE_SECRET_KEY=sb_sec_...


# Financial & Tax Configuration
DEFAULT_TAX_RATE=0.12
DEFAULT_RESORT_FEE=35.0

# Channex.io OTA Channel Manager (Expedia, Booking.com, Airbnb)
# Option 1: Pull Method (Booking Revisions Feed API)
CHANNEX_API_KEY=your_channex_api_key_here
CHANNEX_ENVIRONMENT=staging # 'staging' (sandbox) or 'production'
# Optional override for direct staging/production endpoints:
# CHANNEX_BASE_URL=https://staging.channex.io/api/v1

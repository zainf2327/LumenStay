# LumenStay Server Environment Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Supabase PostgreSQL Configuration
# Set these from your Supabase Project Settings -> API & Keys:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_pub_...
SUPABASE_SECRET_KEY=sb_sec_...

# Legacy key support (optional fallback):
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# Financial & Tax Configuration
DEFAULT_TAX_RATE=0.12
DEFAULT_RESORT_FEE=35.0
